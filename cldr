#!/bin/bash
script_path=$0
while [ -L "$script_path" ]; do
  script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd -P) || exit 1
  script_path=$(readlink -- "$script_path") || exit 1
  case "$script_path" in
    /*) ;;
    *) script_path="$script_dir/$script_path" ;;
  esac
done

CDPATH= cd -- "$(dirname -- "$script_path")" || exit 1
exec node bin/index.js "$@"
